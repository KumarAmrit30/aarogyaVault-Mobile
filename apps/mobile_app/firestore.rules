rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      allow read, write:
        if request.auth != null
        && request.auth.uid == userId;
    }

    match /documents/{documentId} {

      allow read, write:
        if request.auth != null
        && request.auth.uid ==
           resource.data.ownerId;

      allow create:
        if request.auth != null
        && request.auth.uid ==
           request.resource.data.ownerId;
    }

    // OCR metadata — written by Cloud Functions, read by document owner
    match /ocr_results/{documentId} {

      allow read:
        if request.auth != null
        && get(/databases/$(database)/documents/documents/$(documentId))
           .data.ownerId == request.auth.uid;

      allow write: if false;
    }

    // Website waitlist — public create only, no reads
    match /waitlist/{entryId} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'createdAt', 'source'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('.*@.*\\..*')
        && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }
  }
}
