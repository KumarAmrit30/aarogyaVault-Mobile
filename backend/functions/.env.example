# Aarogya Vault — Cloud Functions environment
# Copy to .env (same directory) before deploying. The Firebase CLI
# loads .env automatically on `firebase deploy --only functions`.

# Feature flag: "true" enables the Document AI OCR + Gemini medical
# analysis pipeline (v2). Any other value keeps the legacy Gemini OCR
# pipeline (v1). Rollback = set to "false" and redeploy. No code change.
USE_DOCUMENT_AI_OCR=false

# Document AI (required only when USE_DOCUMENT_AI_OCR=true)
# Project that hosts the Document AI processor.
DOCUMENT_AI_PROJECT_ID=aarogya-vault-dev
# Processor region: "us" or "eu" (Document AI multi-regions).
DOCUMENT_AI_LOCATION=us
# Enterprise Document OCR processor ID from the Document AI console.
# Must be type Document OCR — NOT basic OCR_PROCESSOR.
# See docs/document-ai-setup.md for setup instructions.
DOCUMENT_AI_PROCESSOR_ID=your-processor-id
